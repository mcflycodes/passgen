# Generated by pnpm headers:gen. Edit scripts/lib/site-configs.ts instead.
# Docker Compose recipe: verified release files served by the official Caddy image.
# Set PASSGEN_DOMAIN in .env; Caddy obtains and renews the certificate.
{$PASSGEN_DOMAIN} {
	root * /srv/passgen
	@bad_method not method GET HEAD
	@blocked path_regexp blocked (?i)(^|/)\.|\.(php[0-9]*|phtml|phar|cgi|pl|py|sh|shtml|map)(/|$)|^/(icons|cgi-bin)(/|$)|^/poweredby\.png$
	@hashed path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.(js|css|woff2|png|svg|ico)$
	route {
		import /etc/caddy/passgen-headers.caddy
		header -Server
		header Cache-Control "no-cache"
		error @bad_method "Method not allowed" 405
		error @blocked "Forbidden" 403
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		file_server {
			index index.html
			# No browse. Publish only verified regular files; no payload symlinks.
		}
	}
	handle_errors {
		import /etc/caddy/passgen-headers.caddy
		header -Server
		header Cache-Control "no-cache"
		respond "Request refused" {err.status_code}
	}
}
# Explicit redirect instead of Caddy's automatic one, so it carries the same headers.
# Caddy still answers ACME HTTP challenges on port 80.
http://{$PASSGEN_DOMAIN} {
	import /etc/caddy/passgen-headers.caddy
	header -Server
	header Cache-Control "no-cache"
	redir https://{host}{uri} 308
}
