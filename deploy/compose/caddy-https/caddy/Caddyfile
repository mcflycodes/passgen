# Generated by pnpm headers:gen. Edit scripts/lib/site-configs.ts instead.
# Docker Compose recipe: Caddy terminates HTTPS in front of the PassGen image.
# Set PASSGEN_DOMAIN in .env; Caddy obtains and renews the certificate.
# Upstream responses keep the image's own nine headers: add no header rules here.
# Responses Caddy creates itself, such as 502 while PassGen is down, get the same
# generated headers in handle_errors.
{$PASSGEN_DOMAIN} {
	reverse_proxy passgen:8080
	handle_errors {
		import /etc/caddy/passgen-headers.caddy
		header -Server
		header Cache-Control "no-cache"
		respond "PassGen is unavailable" {err.status_code}
	}
}
# Explicit redirect instead of Caddy's automatic one, so it carries the same headers.
# Caddy still answers ACME HTTP challenges on port 80.
http://{$PASSGEN_DOMAIN} {
	import /etc/caddy/passgen-headers.caddy
	header -Server
	header Cache-Control "no-cache"
	redir https://{host}{uri} 308
}
